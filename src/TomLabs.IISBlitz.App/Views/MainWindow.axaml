<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TomLabs.IISBlitz.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:behaviours="clr-namespace:TomLabs.IISBlitz.App.Behaviours"
        xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
        xmlns:models="clr-namespace:TomLabs.IISBlitz.App.Models"
        xmlns:controls="clr-namespace:TomLabs.IISBlitz.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="TomLabs.IISBlitz.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/lightning.ico"
        Title="IISBlitz"
        MinWidth="900" MinHeight="600"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">

        <!-- Main content -->
        <SplitView Grid.Row="0"
                   IsPaneOpen="True"
                   DisplayMode="Inline"
                   OpenPaneLength="300">

            <!-- Left Pane: Site List -->
            <SplitView.Pane>
                <DockPanel>
                    <!-- Header bar -->
                    <Border DockPanel.Dock="Top" Padding="12,10" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <avalonia:Icon Value="fa-solid fa-bolt" FontSize="18" Foreground="#FFC107"/>
                                <TextBlock Text="IISBlitz" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Command="{Binding SiteViewModel.ToggleThemeCmd}"
                                    ToolTip.Tip="Toggle dark/light theme"
                                    Background="Transparent"
                                    Padding="8" Margin="0,0,4,0">
                                <avalonia:Icon Value="fa-solid fa-circle-half-stroke" FontSize="14"/>
                            </Button>
                            <Button Grid.Column="3"
                                    Command="{Binding SiteViewModel.RefreshSitesCmd}"
                                    ToolTip.Tip="Refresh sites (F5)"
                                    Background="Transparent"
                                    Padding="8">
                                <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Search box -->
                    <TextBox DockPanel.Dock="Top"
                             Name="SearchBox"
                             Watermark="Search sites... (Ctrl+F)"
                             Text="{Binding SiteViewModel.SearchText}"
                             Margin="8,8,8,4"/>

                    <!-- Site list -->
                    <ListBox Name="SitesList"
                             Margin="4,4,4,0"
                             ItemsSource="{Binding SiteViewModel.FilteredSiteList}"
                             SelectedItem="{Binding SiteViewModel.SelectedSite}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SiteInfo">
                                <Grid ColumnDefinitions="Auto,*" Margin="4,6">
                                    <!-- Status indicator circle -->
                                    <Ellipse Grid.Column="0"
                                             Width="12" Height="12"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Fill="#4CAF50"
                                             IsVisible="{Binding IsRunning}"/>
                                    <Ellipse Grid.Column="0"
                                             Width="12" Height="12"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Fill="#9E9E9E"
                                             IsVisible="{Binding !IsRunning}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding AppPool}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </SplitView.Pane>

            <!-- Right Pane: Detail area -->
            <Grid RowDefinitions="Auto,*">

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Padding="8,6"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        IsVisible="{Binding SiteViewModel.SelectedSite, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Site controls -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Command="{Binding SiteViewModel.StartWebCmd}"
                                    IsVisible="{Binding !SiteViewModel.SelectedSite.IsRunning}"
                                    ToolTip.Tip="Start website"
                                    Padding="10,6" Background="#1B5E20" Foreground="White" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:Icon Value="fa-solid fa-play" FontSize="11"/>
                                    <TextBlock Text="Start" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SiteViewModel.StopWebCmd}"
                                    IsVisible="{Binding SiteViewModel.SelectedSite.IsRunning}"
                                    ToolTip.Tip="Stop website"
                                    Padding="10,6" Background="#B71C1C" Foreground="White" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:Icon Value="fa-solid fa-stop" FontSize="11"/>
                                    <TextBlock Text="Stop" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SiteViewModel.RestartSiteCmd}"
                                    ToolTip.Tip="Restart website"
                                    Padding="10,6" Background="#E65100" Foreground="White" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:Icon Value="fa-solid fa-rotate" FontSize="11"/>
                                    <TextBlock Text="Restart" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Command="{Binding SiteViewModel.BrowseSiteCmd}"
                                ToolTip.Tip="Open in browser"
                                Padding="8,6" Background="Transparent" CornerRadius="4">
                            <avalonia:Icon Value="fa-solid fa-globe" FontSize="14"/>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0" VerticalAlignment="Center" Opacity="0.5"/>

                        <!-- App pool controls -->
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Command="{Binding SiteViewModel.StartPoolCmd}"
                                    IsVisible="{Binding !SiteViewModel.SelectedSite.IsPoolRunning}"
                                    ToolTip.Tip="Start application pool"
                                    Padding="10,6" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:Icon Value="fa-solid fa-play" FontSize="11"/>
                                    <TextBlock Text="Start Pool" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SiteViewModel.StopPoolCmd}"
                                    IsVisible="{Binding SiteViewModel.SelectedSite.IsPoolRunning}"
                                    ToolTip.Tip="Stop application pool"
                                    Padding="10,6" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:Icon Value="fa-solid fa-stop" FontSize="11"/>
                                    <TextBlock Text="Stop Pool" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SiteViewModel.RecyclePoolCmd}"
                                    ToolTip.Tip="Recycle application pool (Ctrl+R)"
                                    Padding="10,6" Background="#1565C0" Foreground="White" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:Icon Value="fa-solid fa-recycle" FontSize="11"/>
                                    <TextBlock Text="Recycle" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0" VerticalAlignment="Center" Opacity="0.5"/>

                        <!-- Health check -->
                        <Button Command="{Binding SiteViewModel.HealthCheckCmd}"
                                ToolTip.Tip="HTTP health check"
                                Padding="10,6" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <avalonia:Icon Value="fa-solid fa-heart-pulse" FontSize="11"/>
                                <TextBlock Text="Ping" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Border Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0" VerticalAlignment="Center" Opacity="0.5"/>

                        <!-- File/folder actions — icon-only compact buttons -->
                        <Button Command="{Binding SiteViewModel.OpenWebFolderCmd}"
                                ToolTip.Tip="Open folder in Explorer"
                                Padding="8,6" Background="Transparent" CornerRadius="4">
                            <avalonia:Icon Value="fa-solid fa-folder-open" FontSize="14"/>
                        </Button>
                        <Button Command="{Binding SiteViewModel.CopyPathCmd}"
                                ToolTip.Tip="Copy physical path"
                                Padding="8,6" Background="Transparent" CornerRadius="4">
                            <avalonia:Icon Value="fa-solid fa-copy" FontSize="14"/>
                        </Button>
                        <Button Command="{Binding SiteViewModel.OpenAppSettingsCmd}"
                                ToolTip.Tip="Edit appsettings.json"
                                Padding="8,6" Background="Transparent" CornerRadius="4">
                            <avalonia:Icon Value="fa-solid fa-gear" FontSize="14"/>
                        </Button>
                        <Button Command="{Binding SiteViewModel.OpenWebConfigCmd}"
                                ToolTip.Tip="Edit web.config"
                                Padding="8,6" Background="Transparent" CornerRadius="4">
                            <avalonia:Icon Value="fa-solid fa-file-code" FontSize="14"/>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- Tab control -->
                <TabControl Grid.Row="1" Margin="5">

                    <!-- Details tab -->
                    <TabItem Header="Details" IsVisible="{Binding SiteViewModel.SelectedSite, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <ScrollViewer Padding="16">
                            <StackPanel Spacing="16">

                                <!-- Site info -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Site Information" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" Margin="0,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SiteViewModel.SelectedSite.Name}" Margin="0,2"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Physical Path:" FontWeight="SemiBold" Margin="0,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SiteViewModel.SelectedSite.PhysicalPath}" Margin="0,2" TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="App Pool:" FontWeight="SemiBold" Margin="0,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SiteViewModel.SelectedSite.AppPool}" Margin="0,2"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Site State:" FontWeight="SemiBold" Margin="0,2"/>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#4CAF50" IsVisible="{Binding SiteViewModel.SelectedSite.IsRunning}" VerticalAlignment="Center"/>
                                            <Ellipse Width="10" Height="10" Fill="#9E9E9E" IsVisible="{Binding !SiteViewModel.SelectedSite.IsRunning}" VerticalAlignment="Center"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}">
                                                        <Binding Path="SiteViewModel.SelectedSite.IsRunning"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pool State:" FontWeight="SemiBold" Margin="0,2"/>
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,2">
                                            <Ellipse Width="10" Height="10" Fill="#4CAF50" IsVisible="{Binding SiteViewModel.SelectedSite.IsPoolRunning}" VerticalAlignment="Center"/>
                                            <Ellipse Width="10" Height="10" Fill="#9E9E9E" IsVisible="{Binding !SiteViewModel.SelectedSite.IsPoolRunning}" VerticalAlignment="Center"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}">
                                                        <Binding Path="SiteViewModel.SelectedSite.IsPoolRunning"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Bindings -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Bindings" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="4">
                                        <DataGrid ItemsSource="{Binding SiteViewModel.SelectedSite.Bindings}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  CanUserResizeColumns="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="100"/>
                                                <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/>
                                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="80"/>
                                                <DataGridTextColumn Header="Binding Info" Binding="{Binding BindingInformation}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>

                                <!-- Worker Processes -->
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Worker Processes" FontWeight="Bold" FontSize="16"/>
                                        <Button Command="{Binding SiteViewModel.LoadWorkerProcessesCmd}"
                                                ToolTip.Tip="Refresh worker processes"
                                                Padding="4" Background="Transparent" CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="11"/>
                                        </Button>
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="4">
                                        <DataGrid ItemsSource="{Binding SiteViewModel.SelectedSite.WorkerProcesses}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  MaxHeight="150">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                                                <DataGridTextColumn Header="App Pool" Binding="{Binding AppPoolName}" Width="*"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="100"/>
                                                <DataGridTextColumn Header="Memory (KB)" Binding="{Binding MemoryKb}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>

                                <!-- SSL Certificates -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="SSL Certificates" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="4">
                                        <DataGrid ItemsSource="{Binding SiteViewModel.SelectedSite.Certificates}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  MaxHeight="150">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                                                <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="*"/>
                                                <DataGridTextColumn Header="Expires" Binding="{Binding NotAfter, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60"/>
                                                <DataGridTextColumn Header="Thumbprint" Binding="{Binding Thumbprint}" Width="150"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </StackPanel>

                                <!-- Response Time Chart -->
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Response Time" FontWeight="Bold" FontSize="16"/>
                                        <Button Command="{Binding SiteViewModel.HealthCheckCmd}"
                                                ToolTip.Tip="Single health check"
                                                Padding="4" Background="Transparent" CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <avalonia:Icon Value="fa-solid fa-heart-pulse" FontSize="11"/>
                                        </Button>
                                        <Button Command="{Binding SiteViewModel.RunHealthCheckSeriesCmd}"
                                                ToolTip.Tip="Run 5 pings (builds chart)"
                                                Padding="6,4" CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <avalonia:Icon Value="fa-solid fa-chart-line" FontSize="11"/>
                                                <TextBlock Text="5x Ping" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8" Height="120">
                                        <controls:SparklineChart Values="{Binding SiteViewModel.ResponseTimeValues}"
                                                                  Label="Response Time (ms)"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- appsettings.json tab -->
                    <TabItem Header="appsettings.json">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="8,4"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <!-- Environment selector -->
                                    <TextBlock Text="Environment:" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                                    <ComboBox ItemsSource="{Binding SiteViewModel.SelectedSite.AvailableEnvironments}"
                                              SelectedItem="{Binding SiteViewModel.SelectedSite.CurrentEnvironment}"
                                              MinWidth="160" FontSize="12" Padding="8,4" VerticalAlignment="Center"/>
                                    <Button Command="{Binding SiteViewModel.SetEnvironmentCmd}"
                                            CommandParameter="{Binding SiteViewModel.SelectedSite.CurrentEnvironment}"
                                            ToolTip.Tip="Apply environment to web.config and load settings"
                                            Padding="8,5" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:Icon Value="fa-solid fa-check" FontSize="12"/>
                                            <TextBlock Text="Apply" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Separator -->
                                    <Border Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="2,0" VerticalAlignment="Center" Opacity="0.5"/>

                                    <Button Command="{Binding SiteViewModel.SaveAppSettingsCmd}"
                                            ToolTip.Tip="Save changes (Ctrl+S)"
                                            Padding="10,5" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:Icon Value="fa-solid fa-floppy-disk" FontSize="12"/>
                                            <TextBlock Text="Save" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SiteViewModel.ReloadAppSettingsCmd}"
                                            ToolTip.Tip="Reload from disk"
                                            Padding="8,5" Background="Transparent" CornerRadius="4">
                                        <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                                    </Button>

                                    <!-- Current file indicator -->
                                    <Border Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="2,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    <avalonia:Icon Value="fa-solid fa-file-code" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SiteViewModel.SelectedSite.SelectedAppSettingsFile}"
                                               VerticalAlignment="Center" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </Border>
                            <avaloniaEdit:TextEditor x:Name="AppSettingsEditor"
                                                     ShowLineNumbers="True"
                                                     FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                                     FontSize="13">
                                <Interaction.Behaviors>
                                    <behaviours:DocumentTextBindingBehavior Text="{Binding SiteViewModel.SelectedSite.AppSettingsContent, Mode=TwoWay}"/>
                                </Interaction.Behaviors>
                            </avaloniaEdit:TextEditor>
                        </DockPanel>
                    </TabItem>

                    <!-- web.config tab -->
                    <TabItem Header="web.config">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="8,4"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Command="{Binding SiteViewModel.SaveWebConfigCmd}"
                                            ToolTip.Tip="Save changes (Ctrl+S)"
                                            Padding="10,5" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:Icon Value="fa-solid fa-floppy-disk" FontSize="12"/>
                                            <TextBlock Text="Save" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SiteViewModel.ReloadWebConfigCmd}"
                                            ToolTip.Tip="Reload from disk"
                                            Padding="8,5" Background="Transparent" CornerRadius="4">
                                        <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <avaloniaEdit:TextEditor x:Name="WebConfigEditor"
                                                     ShowLineNumbers="True"
                                                     FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                                     FontSize="13">
                                <Interaction.Behaviors>
                                    <behaviours:DocumentTextBindingBehavior Text="{Binding SiteViewModel.SelectedSite.WebConfigContent, Mode=TwoWay}"/>
                                </Interaction.Behaviors>
                            </avaloniaEdit:TextEditor>
                        </DockPanel>
                    </TabItem>

                    <!-- Permissions tab -->
                    <TabItem Header="Permissions">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="8,4"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Command="{Binding SiteViewModel.LoadPermissionsCmd}"
                                            ToolTip.Tip="Reload permissions"
                                            Padding="8,5" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                                            <TextBlock Text="Refresh" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    <TextBox Watermark="User or group (e.g. IIS_IUSRS)"
                                             Text="{Binding SiteViewModel.NewPermissionIdentity}"
                                             MinWidth="180" FontSize="12" Padding="6,3" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{Binding SiteViewModel.NewPermissionRights}" MinWidth="140" FontSize="12" Padding="6,3">
                                        <ComboBoxItem Content="FullControl"/>
                                        <ComboBoxItem Content="Modify"/>
                                        <ComboBoxItem Content="ReadAndExecute"/>
                                        <ComboBoxItem Content="Read"/>
                                        <ComboBoxItem Content="Write"/>
                                        <ComboBoxItem Content="ListDirectory"/>
                                    </ComboBox>
                                    <ComboBox SelectedItem="{Binding SiteViewModel.NewPermissionType}" MinWidth="80" FontSize="12" Padding="6,3">
                                        <ComboBoxItem Content="Allow"/>
                                        <ComboBoxItem Content="Deny"/>
                                    </ComboBox>
                                    <Button Command="{Binding SiteViewModel.AddPermissionCmd}"
                                            ToolTip.Tip="Add permission"
                                            Padding="10,5" CornerRadius="4" Background="#1B5E20" Foreground="White">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:Icon Value="fa-solid fa-plus" FontSize="12"/>
                                            <TextBlock Text="Add" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <DataGrid ItemsSource="{Binding SiteViewModel.SelectedSite.Permissions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" Width="*"/>
                                    <DataGridTextColumn Header="Rights" Binding="{Binding Rights}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding AccessType}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="Inherited" Binding="{Binding IsInherited}" Width="80"/>
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="models:FolderPermissionEntry">
                                                <Button Command="{Binding #SitesList.((vm:MainWindowViewModel)DataContext).SiteViewModel.RemovePermissionCmd}"
                                                        CommandParameter="{Binding Identity}"
                                                        IsVisible="{Binding !IsInherited}"
                                                        ToolTip.Tip="Remove this permission"
                                                        Padding="4,2" Background="Transparent" CornerRadius="3">
                                                    <avalonia:Icon Value="fa-solid fa-trash" FontSize="10" Foreground="#EF5350"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Logs tab -->
                    <TabItem Header="Logs">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Log file list toolbar -->
                            <Border Grid.Row="0" Padding="8,4"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Command="{Binding SiteViewModel.RefreshLogsCmd}"
                                            ToolTip.Tip="Refresh log file list"
                                            Padding="8,5" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                                            <TextBlock Text="Refresh" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding SiteViewModel.SelectedSite.SelectedLogPath}"
                                               VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="8,0"/>

                                    <!-- Separator -->
                                    <Border Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0" VerticalAlignment="Center" Opacity="0.5"/>

                                    <!-- Log search -->
                                    <TextBox Watermark="Search all logs..."
                                             Text="{Binding SiteViewModel.LogSearchText}"
                                             MinWidth="180" FontSize="12" Padding="6,3" VerticalAlignment="Center"/>
                                    <Button Command="{Binding SiteViewModel.SearchLogCmd}"
                                            ToolTip.Tip="Search across all log files"
                                            Padding="8,5" CornerRadius="4">
                                        <avalonia:Icon Value="fa-solid fa-magnifying-glass" FontSize="12"/>
                                    </Button>
                                    <TextBlock Text="{Binding SiteViewModel.LogSearchStatus}"
                                               VerticalAlignment="Center" FontSize="11" Foreground="#4FC3F7" Margin="4,0"/>
                                    <Button Command="{Binding SiteViewModel.ClearLogSearchCmd}"
                                            IsVisible="{Binding SiteViewModel.HasLogSearchResults}"
                                            ToolTip.Tip="Clear search"
                                            Padding="6,3" CornerRadius="4" Background="Transparent">
                                        <avalonia:Icon Value="fa-solid fa-xmark" FontSize="11" Opacity="0.6"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <!-- Split: file list + log content -->
                            <Grid Grid.Row="1" ColumnDefinitions="250,*">
                                <!-- Left panel: regular file list or search results -->
                                <Grid Grid.Column="0">
                                    <!-- Regular file list -->
                                    <ListBox Margin="4" ItemsSource="{Binding SiteViewModel.SelectedSite.Logs}"
                                             IsVisible="{Binding !SiteViewModel.HasLogSearchResults}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="*,Auto" Margin="2,2">
                                                    <Button Grid.Column="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="4,4"
                                                            CornerRadius="3"
                                                            Command="{Binding #SitesList.((vm:MainWindowViewModel)DataContext).SiteViewModel.ViewLogCmd}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <avalonia:Icon Value="fa-solid fa-file-lines" FontSize="11" Opacity="0.6"/>
                                                            <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding #SitesList.((vm:MainWindowViewModel)DataContext).SiteViewModel.OpenWebLogCmd}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Open in external editor"
                                                            Padding="4,2" Background="Transparent" CornerRadius="3">
                                                        <avalonia:Icon Value="fa-solid fa-arrow-up-right-from-square" FontSize="10"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Search results list -->
                                    <DockPanel IsVisible="{Binding SiteViewModel.HasLogSearchResults}" Margin="4">
                                        <Border DockPanel.Dock="Top" Padding="6,4" Margin="0,0,0,4"
                                                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                                CornerRadius="4">
                                            <TextBlock Text="🔍 Search Results" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                        <ListBox ItemsSource="{Binding SiteViewModel.LogSearchResults}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:LogSearchResult">
                                                    <Button HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            Padding="6,5"
                                                            CornerRadius="3"
                                                            Command="{Binding #SitesList.((vm:MainWindowViewModel)DataContext).SiteViewModel.ViewSearchResultCmd}"
                                                            CommandParameter="{Binding FullPath}">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                                <avalonia:Icon Value="fa-solid fa-file-lines" FontSize="11" Foreground="#4FC3F7"/>
                                                                <TextBlock Text="{Binding FileName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#334FC3F7" CornerRadius="8" Padding="6,1">
                                                                <TextBlock Text="{Binding MatchCount}" FontSize="10" Foreground="#4FC3F7" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Grid>

                                <!-- Log content viewer -->
                                <Border Grid.Column="1" BorderThickness="1,0,0,0"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                    <avaloniaEdit:TextEditor x:Name="LogViewer"
                                                             ShowLineNumbers="True"
                                                             IsReadOnly="True"
                                                             FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                                             FontSize="12"
                                                             WordWrap="True">
                                        <Interaction.Behaviors>
                                            <behaviours:DocumentTextBindingBehavior Text="{Binding SiteViewModel.SelectedSite.SelectedLogContent, Mode=OneWay}"/>
                                        </Interaction.Behaviors>
                                    </avaloniaEdit:TextEditor>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Events tab -->
                    <TabItem Header="Events">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="8,4"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Command="{Binding SiteViewModel.LoadEventLogCmd}"
                                            ToolTip.Tip="Load events from last 24h"
                                            Padding="8,5" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                                            <TextBlock Text="Load Events" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Width="1" Height="20" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,0" VerticalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="Filter:" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                                    <ComboBox SelectedItem="{Binding SiteViewModel.EventLogFilter}" MinWidth="100" FontSize="12" Padding="8,4">
                                        <ComboBoxItem Content="All"/>
                                        <ComboBoxItem Content="Error"/>
                                        <ComboBoxItem Content="Warning"/>
                                        <ComboBoxItem Content="Info"/>
                                    </ComboBox>
                                    <Button Command="{Binding SiteViewModel.FilterEventLogCmd}"
                                            CommandParameter="{Binding SiteViewModel.EventLogFilter}"
                                            ToolTip.Tip="Apply filter"
                                            Padding="8,5" CornerRadius="4">
                                        <avalonia:Icon Value="fa-solid fa-filter" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <DataGrid ItemsSource="{Binding SiteViewModel.EventLogEntries}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimeGenerated, StringFormat='{}{0:HH:mm:ss}'}" Width="80"/>
                                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="140"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Response tab -->
                    <TabItem Header="Response">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="8,4"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Command="{Binding SiteViewModel.FetchSiteResponseCmd}"
                                            ToolTip.Tip="Fetch site response"
                                            Padding="8,5" CornerRadius="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <avalonia:Icon Value="fa-solid fa-download" FontSize="12"/>
                                            <TextBlock Text="Fetch" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Loading..." FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                               IsVisible="{Binding SiteViewModel.IsLoadingResponse}"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer>
                                <StackPanel Spacing="12" Margin="16"
                                            IsVisible="{Binding SiteViewModel.SiteResponse, Converter={x:Static ObjectConverters.IsNotNull}}">

                                    <!-- Status summary -->
                                    <Border Padding="12" CornerRadius="6"
                                            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                                        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Status" FontSize="10" Opacity="0.5"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding SiteViewModel.SiteResponse.StatusCode}"
                                                               FontSize="20" FontWeight="Bold" Foreground="#4FC3F7"/>
                                                    <TextBlock Text="{Binding SiteViewModel.SiteResponse.StatusDescription}"
                                                               FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0.7"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Response Time" FontSize="10" Opacity="0.5"/>
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <TextBlock Text="{Binding SiteViewModel.SiteResponse.ResponseTimeMs}"
                                                               FontSize="20" FontWeight="Bold"/>
                                                    <TextBlock Text="ms" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0.5"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="Content Size" FontSize="10" Opacity="0.5"/>
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <TextBlock Text="{Binding SiteViewModel.SiteResponse.ContentLength}"
                                                               FontSize="20" FontWeight="Bold"/>
                                                    <TextBlock Text="bytes" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,2" Opacity="0.5"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="2">
                                                <TextBlock Text="Server" FontSize="10" Opacity="0.5"/>
                                                <TextBlock Text="{Binding SiteViewModel.SiteResponse.Server}"
                                                           FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Page meta info -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Page Info" FontWeight="Bold" FontSize="16" Margin="0,0,0,4"/>
                                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SiteViewModel.SiteResponse.PageTitle}" Margin="0,2" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SiteViewModel.SiteResponse.MetaDescription}" Margin="0,2" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Generator:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SiteViewModel.SiteResponse.MetaGenerator}" Margin="0,2"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Content-Type:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SiteViewModel.SiteResponse.ContentType}" Margin="0,2"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="X-Powered-By:" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SiteViewModel.SiteResponse.PoweredBy}" Margin="0,2"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- HTTP Headers -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="HTTP Headers" FontWeight="Bold" FontSize="16" Margin="0,0,0,4"/>
                                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1" CornerRadius="4">
                                            <DataGrid ItemsSource="{Binding SiteViewModel.SiteResponse.Headers}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      MaxHeight="200">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Header" Binding="{Binding Name}" Width="200"/>
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Raw HTML preview -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Response Body" FontWeight="Bold" FontSize="16" Margin="0,0,0,4"/>
                                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                BorderThickness="1" CornerRadius="4" MaxHeight="300">
                                            <avaloniaEdit:TextEditor x:Name="ResponseBodyViewer"
                                                                     ShowLineNumbers="True"
                                                                     IsReadOnly="True"
                                                                     FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                                                     FontSize="11"
                                                                     WordWrap="True">
                                                <Interaction.Behaviors>
                                                    <behaviours:DocumentTextBindingBehavior Text="{Binding SiteViewModel.SiteResponse.RawHtml, Mode=OneWay}"/>
                                                </Interaction.Behaviors>
                                            </avaloniaEdit:TextEditor>
                                        </Border>
                                    </StackPanel>

                                    <!-- JS Console -->
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="JS Console" FontWeight="Bold" FontSize="16"/>
                                            <Button Command="{Binding SiteViewModel.CaptureJsConsoleCmd}"
                                                    ToolTip.Tip="Run page in headless browser and capture console output"
                                                    Padding="8,4" CornerRadius="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <avalonia:Icon Value="fa-solid fa-terminal" FontSize="11"/>
                                                    <TextBlock Text="Capture" VerticalAlignment="Center" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="Loading browser..." FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                                                       IsVisible="{Binding SiteViewModel.IsLoadingConsole}"/>
                                        </StackPanel>
                                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                BorderThickness="1" CornerRadius="4">
                                            <DataGrid ItemsSource="{Binding SiteViewModel.JsConsoleMessages}"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      MaxHeight="200">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" Width="90"/>
                                                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70"/>
                                                    <DataGridTextColumn Header="Message" Binding="{Binding Text}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </SplitView>

        <!-- Status Bar -->
        <Border Grid.Row="1"
                Padding="12,6"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           FontSize="12"
                           Opacity="0.7"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} sites">
                            <Binding Path="SiteViewModel.TotalSiteCount"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Text="{Binding SiteViewModel.HealthCheckResult}"
                           FontSize="12"
                           Margin="20,0,0,0"
                           Foreground="#4FC3F7"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding SiteViewModel.StatusText}"
                           FontSize="12"
                           Opacity="0.7"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>

</Window>
