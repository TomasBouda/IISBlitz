<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TomLabs.IISBlitz.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        xmlns:behaviours="clr-namespace:TomLabs.IISBlitz.App.Behaviours"
        xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
        xmlns:models="clr-namespace:TomLabs.IISBlitz.App.Models"
        xmlns:controls="clr-namespace:TomLabs.IISBlitz.App.Controls"
        xmlns:converters="clr-namespace:TomLabs.IISBlitz.App.Converters"
        xmlns:update="clr-namespace:TomLabs.AutoUpdate.Avalonia;assembly=TomLabs.AutoUpdate.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
        x:Class="TomLabs.IISBlitz.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/lightning.ico"
        Title="IISBlitz"
        MinWidth="960" MinHeight="620"
        Width="1180" Height="740"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <Grid RowDefinitions="44,*,Auto">

            <!-- ===== Header ===== -->
            <Border Grid.Row="0" Classes="hairline-b" Padding="14,0,150,0" Name="HeaderBar" Background="Transparent" PointerPressed="OnHeaderPointerPressed">
                <Grid ColumnDefinitions="Auto,12,360,*,Auto,12,Auto,Auto,12,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <avalonia:Icon Value="fa-solid fa-bolt" FontSize="15" Foreground="{DynamicResource BoltBrush}"/>
                        <TextBlock Text="IISBlitz" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Command palette trigger -->
                    <Button Grid.Column="2" Name="PaletteButton" Click="OnPaletteButtonClick"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Padding="10,5" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource HairlineStrongBrush}"
                            ToolTip.Tip="Search sites and actions (Ctrl+K)">
                        <Grid ColumnDefinitions="Auto,8,*,Auto">
                            <avalonia:Icon Grid.Column="0" Value="fa-solid fa-magnifying-glass" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="Jump to site or action…" Classes="muted" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                <Border Classes="kbd"><TextBlock Text="Ctrl"/></Border>
                                <Border Classes="kbd"><TextBlock Text="K"/></Border>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="4" Classes="mono muted" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} · IIS">
                                <Binding Path="MachineName"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button Grid.Column="6" Classes="icon" Command="{Binding SiteViewModel.RefreshSitesCmd}" ToolTip.Tip="Refresh sites (F5)">
                        <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="13"/>
                    </Button>
                    <Button Grid.Column="7" Classes="icon" Command="{Binding SiteViewModel.ToggleThemeCmd}" ToolTip.Tip="Toggle light / dark (Ctrl+Shift+L)">
                        <avalonia:Icon Value="fa-solid fa-circle-half-stroke" FontSize="13"/>
                    </Button>
                    <TextBlock Grid.Column="9" Classes="mono muted" FontSize="11" Text="{Binding AppVersion}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===== Body ===== -->
            <Grid Grid.Row="1" ColumnDefinitions="240,*">

                <!-- Sidebar -->
                <Border Grid.Column="0" Classes="hairline-r">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,12,14,6">
                            <TextBlock Grid.Column="0" Classes="section" Text="SITES"/>
                            <TextBlock Grid.Column="1" Classes="mono muted" FontSize="10.5" Text="{Binding SiteViewModel.TotalSiteCount}"/>
                        </Grid>
                        <TextBox DockPanel.Dock="Top" Name="SearchBox"
                                 Watermark="Filter sites…  Ctrl+F"
                                 Text="{Binding SiteViewModel.SearchText}"
                                 Margin="12,0,12,8"/>

                        <Border DockPanel.Dock="Bottom" Classes="hairline-t" Padding="14,10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="muted" FontSize="11" Text="Refresh"/>
                                    <Border Grid.Column="1" Classes="kbd"><TextBlock Text="F5"/></Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="muted" FontSize="11" Text="Recycle pool"/>
                                    <Border Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+R"/></Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="muted" FontSize="11" Text="Save file"/>
                                    <Border Grid.Column="1" Classes="kbd"><TextBlock Text="Ctrl+S"/></Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ListBox Name="SitesList" Classes="rows"
                                 ItemsSource="{Binding SiteViewModel.FilteredSiteList}"
                                 SelectedItem="{Binding SiteViewModel.SelectedSite}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SiteInfo">
                                    <Grid ColumnDefinitions="Auto,10,*">
                                        <controls:StatusDot Grid.Column="0" VerticalAlignment="Center"
                                                            IsRunning="{Binding IsRunning}"
                                                            IsLive="{Binding $parent[ListBoxItem].IsSelected}"/>
                                        <StackPanel Grid.Column="2" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       Classes.secondary="{Binding !IsRunning}"/>
                                            <TextBlock Text="{Binding Summary}" Classes="mono muted" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Detail area -->
                <Panel Grid.Column="1">
                    <Grid RowDefinitions="Auto,*"
                          IsVisible="{Binding SiteViewModel.SelectedSite, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <!-- Site header + actions -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,14,18,10" Classes="fade-in">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="title" Text="{Binding SiteViewModel.SelectedSite.Name}"/>
                                    <Border Classes="chip running" IsVisible="{Binding SiteViewModel.SelectedSite.IsRunning}">
                                        <TextBlock Text="RUNNING"/>
                                    </Border>
                                    <Border Classes="chip" IsVisible="{Binding !SiteViewModel.SelectedSite.IsRunning}">
                                        <TextBlock Text="STOPPED"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="mono muted" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} · {1}">
                                            <Binding Path="SiteViewModel.SelectedSite.PhysicalPath"/>
                                            <Binding Path="SiteViewModel.SelectedSite.AppPool"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Command="{Binding SiteViewModel.StartWebCmd}" IsVisible="{Binding !SiteViewModel.SelectedSite.IsRunning}" ToolTip.Tip="Start website">
                                    <StackPanel><avalonia:Icon Value="fa-solid fa-play" FontSize="10"/><TextBlock Text="Start"/></StackPanel>
                                </Button>
                                <Button Command="{Binding SiteViewModel.StopWebCmd}" IsVisible="{Binding SiteViewModel.SelectedSite.IsRunning}" ToolTip.Tip="Stop website">
                                    <StackPanel><avalonia:Icon Value="fa-solid fa-stop" FontSize="10"/><TextBlock Text="Stop"/></StackPanel>
                                </Button>
                                <Button Command="{Binding SiteViewModel.RestartSiteCmd}" ToolTip.Tip="Restart website (stop + start)">
                                    <StackPanel><avalonia:Icon Value="fa-solid fa-rotate" FontSize="11"/><TextBlock Text="Restart"/></StackPanel>
                                </Button>
                                <Border Classes="vsep"/>
                                <Button Command="{Binding SiteViewModel.StartPoolCmd}" IsVisible="{Binding !SiteViewModel.SelectedSite.IsPoolRunning}" ToolTip.Tip="Start application pool">
                                    <StackPanel><avalonia:Icon Value="fa-solid fa-play" FontSize="10"/><TextBlock Text="Start pool"/></StackPanel>
                                </Button>
                                <Button Command="{Binding SiteViewModel.StopPoolCmd}" IsVisible="{Binding SiteViewModel.SelectedSite.IsPoolRunning}" ToolTip.Tip="Stop application pool">
                                    <StackPanel><avalonia:Icon Value="fa-solid fa-stop" FontSize="10"/><TextBlock Text="Stop pool"/></StackPanel>
                                </Button>
                                <Button Command="{Binding SiteViewModel.RecyclePoolCmd}" ToolTip.Tip="Recycle application pool (Ctrl+R)">
                                    <StackPanel><avalonia:Icon Value="fa-solid fa-recycle" FontSize="11"/><TextBlock Text="Recycle"/></StackPanel>
                                </Button>
                                <Border Classes="vsep"/>
                                <Button Classes="icon" Command="{Binding SiteViewModel.BrowseSiteCmd}" ToolTip.Tip="Open in browser">
                                    <avalonia:Icon Value="fa-solid fa-globe" FontSize="13"/>
                                </Button>
                                <Button Classes="icon" Command="{Binding SiteViewModel.OpenWebFolderCmd}" ToolTip.Tip="Open folder in Explorer">
                                    <avalonia:Icon Value="fa-solid fa-folder-open" FontSize="13"/>
                                </Button>
                                <Button Classes="icon" Command="{Binding SiteViewModel.CopyPathCmd}" ToolTip.Tip="Copy physical path">
                                    <avalonia:Icon Value="fa-solid fa-copy" FontSize="13"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Tabs -->
                        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

                            <!-- Overview -->
                            <TabItem Header="Overview">
                                <ScrollViewer>
                                    <StackPanel Margin="18,16" Spacing="14">
                                        <Grid ColumnDefinitions="*,10,*,10,*,10,*" Classes="fade-in d1">
                                            <Border Grid.Column="0" Classes="card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="label" Text="Site state"/>
                                                    <TextBlock Classes="value running" Text="Started" IsVisible="{Binding SiteViewModel.SelectedSite.IsRunning}"/>
                                                    <TextBlock Classes="value muted" Text="Stopped" IsVisible="{Binding !SiteViewModel.SelectedSite.IsRunning}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Classes="card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="label" Text="App pool"/>
                                                    <TextBlock Classes="value running" Text="Started" IsVisible="{Binding SiteViewModel.SelectedSite.IsPoolRunning}"/>
                                                    <TextBlock Classes="value muted" Text="Stopped" IsVisible="{Binding !SiteViewModel.SelectedSite.IsPoolRunning}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="4" Classes="card">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="label" Text="Worker memory"/>
                                                    <TextBlock Classes="value" Text="{Binding SiteViewModel.WorkerMemoryText}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="6" Classes="card" ToolTip.Tip="GET /health is probed automatically when a site is selected">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="label" Text="Health endpoint"/>
                                                    <TextBlock Classes="value muted" Text="probing…" IsVisible="{Binding SiteViewModel.HasHealthEndpoint, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                    <TextBlock Classes="value running" Text="{Binding SiteViewModel.HealthEndpointStatus}"
                                                               IsVisible="{Binding SiteViewModel.HasHealthEndpoint, FallbackValue=False, TargetNullValue=False}"/>
                                                    <TextBlock Classes="value muted" Text="not exposed"
                                                               IsVisible="{Binding SiteViewModel.HasHealthEndpoint, Converter={x:Static BoolConverters.Not}, FallbackValue=False, TargetNullValue=False}"/>
                                                    <TextBlock Classes="mono muted" FontSize="10.5" Text="{Binding SiteViewModel.HealthEndpointDetail}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,10,*" Classes="fade-in d3">
                                            <Border Grid.Column="0" Classes="table">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Classes="tablehead">
                                                        <TextBlock Classes="section" Text="BINDINGS"/>
                                                    </Border>
                                                    <DataGrid Classes="mono" ItemsSource="{Binding SiteViewModel.SelectedSite.Bindings}" AutoGenerateColumns="False" MaxHeight="160">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90"/>
                                                            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="*"/>
                                                            <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
                                                            <DataGridTextColumn Header="Binding" Binding="{Binding BindingInformation}" Width="*"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Column="2" Classes="table">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Classes="tablehead" Padding="12,4,6,4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Classes="section" Text="WORKER PROCESSES" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Classes="icon small" Command="{Binding SiteViewModel.LoadWorkerProcessesCmd}" ToolTip.Tip="Refresh worker processes">
                                                                <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="10"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <DataGrid Classes="mono" ItemsSource="{Binding SiteViewModel.SelectedSite.WorkerProcesses}" AutoGenerateColumns="False" MaxHeight="160">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                                                            <DataGridTextColumn Header="App pool" Binding="{Binding AppPoolName}" Width="*"/>
                                                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90"/>
                                                            <DataGridTextColumn Header="Memory (KB)" Binding="{Binding MemoryKb}" Width="110"/>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </DockPanel>
                                            </Border>
                                        </Grid>

                                        <Border Classes="table fade-in d4">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Top" Classes="tablehead">
                                                    <TextBlock Classes="section" Text="SSL CERTIFICATES"/>
                                                </Border>
                                                <DataGrid Classes="mono" ItemsSource="{Binding SiteViewModel.SelectedSite.Certificates}" AutoGenerateColumns="False" MaxHeight="160">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                                                        <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="*"/>
                                                        <DataGridTextColumn Header="Expires" Binding="{Binding NotAfter, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                                                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
                                                        <DataGridTextColumn Header="Thumbprint" Binding="{Binding Thumbprint}" Width="160"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- appsettings.json -->
                            <TabItem Header="appsettings.json">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Classes="hairline-b fade-in" Padding="18,8">
                                        <Grid ColumnDefinitions="Auto,8,Auto,*,Auto,8,Auto,8,Auto,4,Auto,4,Auto">
                                            <avalonia:Icon Grid.Column="0" Value="fa-solid fa-file-code" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Grid.Column="2" Classes="mono secondary" FontSize="11.5" VerticalAlignment="Center"
                                                       Text="{Binding SiteViewModel.SelectedSite.SelectedAppSettingsFile}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="4" Classes="mono muted" FontSize="11" VerticalAlignment="Center"
                                                       ToolTip.Tip="ASPNETCORE_ENVIRONMENT in web.config; when it is not set, ASP.NET Core runs as Production">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}web.config: {0}">
                                                        <Binding Path="SiteViewModel.SelectedSite.ConfiguredEnvironmentText"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <ListBox Grid.Column="6" Classes="segmented"
                                                     ItemsSource="{Binding SiteViewModel.SelectedSite.AppSettingsFiles}"
                                                     SelectedItem="{Binding SiteViewModel.SelectedSite.SelectedAppSettingsFile}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding Converter={x:Static converters:AppSettingsLabelConverter.Instance}}" ToolTip.Tip="{Binding}"/>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Grid.Column="8" Padding="8,4"
                                                    Command="{Binding SiteViewModel.SetEnvironmentCmd}"
                                                    CommandParameter="{Binding SiteViewModel.SelectedAppSettingsEnvironment}"
                                                    IsEnabled="{Binding SiteViewModel.CanApplySelectedEnvironment}"
                                                    ToolTip.Tip="Set ASPNETCORE_ENVIRONMENT in web.config to the selected file's environment">
                                                <StackPanel><avalonia:Icon Value="fa-solid fa-check" FontSize="10"/><TextBlock Text="Apply to web.config"/></StackPanel>
                                            </Button>
                                            <Button Grid.Column="10" Classes="icon" Command="{Binding SiteViewModel.ReloadAppSettingsCmd}" ToolTip.Tip="Reload from disk">
                                                <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                                            </Button>
                                            <Button Grid.Column="12" Classes="accent" Padding="8,4" Command="{Binding SiteViewModel.SaveAppSettingsCmd}" ToolTip.Tip="Save (Ctrl+S)">
                                                <StackPanel><avalonia:Icon Value="fa-solid fa-floppy-disk" FontSize="11"/><TextBlock Text="Save"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <avaloniaEdit:TextEditor x:Name="AppSettingsEditor">
                                        <Interaction.Behaviors>
                                            <behaviours:DocumentTextBindingBehavior Text="{Binding SiteViewModel.SelectedSite.AppSettingsContent, Mode=TwoWay}"/>
                                        </Interaction.Behaviors>
                                    </avaloniaEdit:TextEditor>
                                </DockPanel>
                            </TabItem>

                            <!-- web.config -->
                            <TabItem Header="web.config">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Classes="hairline-b fade-in" Padding="18,8">
                                        <Grid ColumnDefinitions="Auto,8,*,Auto,4,Auto">
                                            <avalonia:Icon Grid.Column="0" Value="fa-solid fa-file-code" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Grid.Column="2" Classes="mono secondary" FontSize="11.5" Text="web.config" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Classes="icon" Command="{Binding SiteViewModel.ReloadWebConfigCmd}" ToolTip.Tip="Reload from disk">
                                                <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                                            </Button>
                                            <Button Grid.Column="5" Classes="accent" Padding="8,4" Command="{Binding SiteViewModel.SaveWebConfigCmd}" ToolTip.Tip="Save (Ctrl+S)">
                                                <StackPanel><avalonia:Icon Value="fa-solid fa-floppy-disk" FontSize="11"/><TextBlock Text="Save"/></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <avaloniaEdit:TextEditor x:Name="WebConfigEditor">
                                        <Interaction.Behaviors>
                                            <behaviours:DocumentTextBindingBehavior Text="{Binding SiteViewModel.SelectedSite.WebConfigContent, Mode=TwoWay}"/>
                                        </Interaction.Behaviors>
                                    </avaloniaEdit:TextEditor>
                                </DockPanel>
                            </TabItem>

                            <!-- Permissions -->
                            <TabItem Header="Permissions">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Classes="hairline-b fade-in" Padding="18,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBox Watermark="User or group, e.g. IIS_IUSRS" Text="{Binding SiteViewModel.NewPermissionIdentity}" MinWidth="220"/>
                                            <ComboBox ItemsSource="{Binding PermissionRights}" SelectedItem="{Binding SiteViewModel.NewPermissionRights}" MinWidth="140"/>
                                            <ComboBox ItemsSource="{Binding PermissionTypes}" SelectedItem="{Binding SiteViewModel.NewPermissionType}" MinWidth="90"/>
                                            <Button Classes="accent" Padding="8,4" Command="{Binding SiteViewModel.AddPermissionCmd}" ToolTip.Tip="Add permission to the site folder">
                                                <StackPanel><avalonia:Icon Value="fa-solid fa-plus" FontSize="10"/><TextBlock Text="Add"/></StackPanel>
                                            </Button>
                                            <Border Classes="vsep"/>
                                            <Button Classes="icon" Command="{Binding SiteViewModel.LoadPermissionsCmd}" ToolTip.Tip="Reload permissions">
                                                <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <DataGrid ItemsSource="{Binding SiteViewModel.SelectedSite.Permissions}" AutoGenerateColumns="False" CanUserSortColumns="True" Classes="fade-in d1">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Identity" Binding="{Binding Identity}" Width="*"/>
                                            <DataGridTextColumn Header="Rights" Binding="{Binding Rights}" Width="*"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding AccessType}" Width="80"/>
                                            <DataGridCheckBoxColumn Header="Inherited" Binding="{Binding IsInherited}" Width="90"/>
                                            <DataGridTemplateColumn Header="" Width="50">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="models:FolderPermissionEntry">
                                                        <Button Classes="icon small"
                                                                Command="{Binding #SitesList.((vm:MainWindowViewModel)DataContext).SiteViewModel.RemovePermissionCmd}"
                                                                CommandParameter="{Binding Identity}"
                                                                IsVisible="{Binding !IsInherited}"
                                                                ToolTip.Tip="Remove this permission">
                                                            <avalonia:Icon Value="fa-solid fa-trash" FontSize="10" Foreground="{DynamicResource ErrorBrush}"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                            <!-- Logs -->
                            <TabItem Header="Logs">
                                <Grid ColumnDefinitions="250,*" Classes="fade-in">
                                    <Border Grid.Column="0" Classes="hairline-r">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Margin="12,10,12,4" Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBox Name="LogSearchBox" Classes="mono" Watermark="Search all logs…  ↵"
                                                             Text="{Binding SiteViewModel.LogSearchText}"/>
                                                    <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0"
                                                            Command="{Binding SiteViewModel.ClearLogSearchCmd}"
                                                            IsVisible="{Binding SiteViewModel.HasLogSearchResults}"
                                                            ToolTip.Tip="Clear search">
                                                        <avalonia:Icon Value="fa-solid fa-xmark" FontSize="11"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Classes="mono accent" FontSize="10.5" Text="{Binding SiteViewModel.LogSearchStatus}"
                                                           IsVisible="{Binding SiteViewModel.LogSearchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            </StackPanel>
                                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,6,8,2">
                                                <TextBlock Classes="section" Text="FILES" IsVisible="{Binding !SiteViewModel.HasLogSearchResults}"/>
                                                <TextBlock Classes="section" Text="RESULTS" IsVisible="{Binding SiteViewModel.HasLogSearchResults}"/>
                                                <Button Grid.Column="1" Classes="icon small" Command="{Binding SiteViewModel.RefreshLogsCmd}" ToolTip.Tip="Refresh file list">
                                                    <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="10"/>
                                                </Button>
                                            </Grid>
                                            <Panel>
                                                <ListBox Name="LogFilesList" Classes="rows compact"
                                                         ItemsSource="{Binding SiteViewModel.SelectedSite.Logs}"
                                                         IsVisible="{Binding !SiteViewModel.HasLogSearchResults}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Grid ColumnDefinitions="Auto,8,*,Auto">
                                                                <avalonia:Icon Grid.Column="0" Value="fa-solid fa-file-lines" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Grid.Column="2" Classes="mono" FontSize="11.5" Text="{Binding Converter={x:Static converters:FileNameConverter.Instance}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding}"/>
                                                                <Button Grid.Column="3" Classes="icon small"
                                                                        Command="{Binding #SitesList.((vm:MainWindowViewModel)DataContext).SiteViewModel.OpenWebLogCmd}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip.Tip="Open in external editor">
                                                                    <avalonia:Icon Value="fa-solid fa-arrow-up-right-from-square" FontSize="9"/>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <ListBox Name="LogResultsList" Classes="rows compact"
                                                         ItemsSource="{Binding SiteViewModel.LogSearchResults}"
                                                         IsVisible="{Binding SiteViewModel.HasLogSearchResults}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="models:LogSearchResult">
                                                            <Grid ColumnDefinitions="Auto,8,*,Auto">
                                                                <avalonia:Icon Grid.Column="0" Value="fa-solid fa-file-lines" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                                                <TextBlock Grid.Column="2" Classes="mono" FontSize="11.5" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="3" Classes="chip accent"><TextBlock Text="{Binding MatchCount}"/></Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Panel>
                                        </DockPanel>
                                    </Border>
                                    <DockPanel Grid.Column="1">
                                        <Border DockPanel.Dock="Top" Classes="hairline-b" Padding="14,8">
                                            <TextBlock Classes="mono muted" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding SiteViewModel.SelectedSite.SelectedLogPath, TargetNullValue='Select a log file'}"/>
                                        </Border>
                                        <avaloniaEdit:TextEditor x:Name="LogViewer" IsReadOnly="True" WordWrap="True" FontSize="11.5">
                                            <Interaction.Behaviors>
                                                <behaviours:DocumentTextBindingBehavior Text="{Binding SiteViewModel.SelectedSite.SelectedLogContent, Mode=OneWay}"/>
                                            </Interaction.Behaviors>
                                        </avaloniaEdit:TextEditor>
                                    </DockPanel>
                                </Grid>
                            </TabItem>

                            <!-- Events -->
                            <TabItem Header="Events">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Classes="hairline-b fade-in" Padding="18,8">
                                        <Grid ColumnDefinitions="Auto,12,Auto,8,Auto,*,Auto,8,Auto">
                                            <TextBlock Grid.Column="0" Classes="muted" FontSize="11" Text="Windows Event Log · last 24 h" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Classes="muted" FontSize="11" Text="Level" VerticalAlignment="Center"/>
                                            <ListBox Grid.Column="4" Classes="segmented" ItemsSource="{Binding EventLevels}" SelectedItem="{Binding SiteViewModel.EventLogFilter}"/>
                                            <TextBlock Grid.Column="6" Classes="mono muted" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} events · IIS, ASP.NET Core, WAS">
                                                        <Binding Path="SiteViewModel.EventLogEntries.Count"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Button Grid.Column="8" Padding="8,4" Command="{Binding SiteViewModel.LoadEventLogCmd}" ToolTip.Tip="Load events from the last 24 hours" IsEnabled="{Binding !SiteViewModel.IsLoadingEvents}">
                                                <StackPanel>
                                                    <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="10"/>
                                                    <TextBlock Text="Load" IsVisible="{Binding !SiteViewModel.IsLoadingEvents}"/>
                                                    <TextBlock Text="Loading…" IsVisible="{Binding SiteViewModel.IsLoadingEvents}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Detail of the selected event -->
                                    <Border DockPanel.Dock="Bottom" Classes="card hairline-t" CornerRadius="0" BorderThickness="0,1,0,0" Padding="18,10" MaxHeight="220"
                                            IsVisible="{Binding SiteViewModel.SelectedEvent, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,8,Auto,8,Auto,*,Auto" Margin="0,0,0,8">
                                                <TextBlock Grid.Column="0" Classes="mono" FontSize="10.5" Text="{Binding SiteViewModel.SelectedEvent.Level}"
                                                           Foreground="{Binding SiteViewModel.SelectedEvent.Level, Converter={x:Static converters:LevelToBrushConverter.Instance}}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Classes="muted" FontSize="11" Text="{Binding SiteViewModel.SelectedEvent.Source}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Classes="mono muted" FontSize="11" Text="{Binding SiteViewModel.SelectedEvent.TimeGenerated, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="6" Padding="8,3" Click="OnCopyEventClick" ToolTip.Tip="Copy the full message to the clipboard">
                                                    <StackPanel Spacing="5"><avalonia:Icon Value="fa-solid fa-copy" FontSize="10"/><TextBlock Text="Copy" FontSize="11"/></StackPanel>
                                                </Button>
                                            </Grid>
                                            <ScrollViewer>
                                                <SelectableTextBlock Classes="mono" FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                                                     Text="{Binding SiteViewModel.SelectedEvent.Message}"/>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>

                                    <DataGrid ItemsSource="{Binding SiteViewModel.EventLogEntries}" SelectedItem="{Binding SiteViewModel.SelectedEvent}"
                                              AutoGenerateColumns="False" CanUserSortColumns="True" Classes="fade-in d1">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Time" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="models:EventLogItem">
                                                        <TextBlock Classes="mono muted" Text="{Binding TimeGenerated, StringFormat='{}{0:HH:mm:ss}'}" VerticalAlignment="Center" Margin="12,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Level" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="models:EventLogItem">
                                                        <TextBlock Classes="mono" FontSize="10" Text="{Binding Level}" VerticalAlignment="Center" Margin="12,0"
                                                                   Foreground="{Binding Level, Converter={x:Static converters:LevelToBrushConverter.Instance}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160"/>
                                            <DataGridTemplateColumn Header="Message" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="models:EventLogItem">
                                                        <TextBlock Text="{Binding Message, Converter={x:Static converters:FirstLineConverter.Instance}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Classes="fade-in"
                                IsVisible="{Binding SiteViewModel.SelectedSite, Converter={x:Static ObjectConverters.IsNull}}">
                        <avalonia:Icon Value="fa-solid fa-bolt" FontSize="28" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a site to get started" Classes="secondary" FontSize="14" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Classes="muted" FontSize="11" Text="or press" VerticalAlignment="Center"/>
                            <Border Classes="kbd"><TextBlock Text="Ctrl"/></Border>
                            <Border Classes="kbd"><TextBlock Text="K"/></Border>
                            <TextBlock Classes="muted" FontSize="11" Text="to jump anywhere" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </Grid>

            <!-- ===== Status bar ===== -->
            <Border Grid.Row="2" Classes="hairline-t" Padding="18,6">
                <Grid ColumnDefinitions="Auto,16,Auto,*,Auto">
                    <TextBlock Grid.Column="0" Classes="muted" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} sites · {1} running">
                                <Binding Path="SiteViewModel.TotalSiteCount"/>
                                <Binding Path="SiteViewModel.RunningSiteCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <update:UpdateBanner Grid.Column="2" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Classes="mono muted" FontSize="11" Text="{Binding SiteViewModel.StatusText}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Command palette (Ctrl+K) ===== -->
        <Panel IsVisible="{Binding Palette.IsOpen}">
            <Border Classes="scrim" PointerPressed="OnScrimPressed"/>
            <Border Classes="popin" Width="560" VerticalAlignment="Top" Margin="0,96,0,0"
                    Background="{DynamicResource BgElevatedBrush}"
                    BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="8"
                    BoxShadow="0 24 60 0 #80000000">
                <Border CornerRadius="8" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="hairline-b" Padding="14,8">
                            <Grid ColumnDefinitions="Auto,10,*,Auto">
                                <avalonia:Icon Grid.Column="0" Value="fa-solid fa-magnifying-glass" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Grid.Column="2" Name="PaletteBox" Classes="bare mono" FontSize="13"
                                         Watermark="Type a site, file or action…"
                                         Text="{Binding Palette.Query}"/>
                                <Border Grid.Column="3" Classes="kbd"><TextBlock Text="Esc"/></Border>
                            </Grid>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Classes="hairline-t" Padding="14,7">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Classes="kbd"><TextBlock Text="↑↓"/></Border>
                                    <TextBlock Classes="muted" FontSize="10.5" Text="navigate" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Classes="kbd"><TextBlock Text="↵"/></Border>
                                    <TextBlock Classes="muted" FontSize="10.5" Text="run" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Classes="muted" FontSize="10.5" Text="fuzzy match across sites, tabs and actions" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ListBox Name="PaletteList" Classes="rows compact" MaxHeight="420" Margin="0,4"
                                 ItemsSource="{Binding Palette.Items}"
                                 SelectedItem="{Binding Palette.SelectedItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PaletteItem">
                                    <Grid ColumnDefinitions="18,10,Auto,10,*,Auto,10,Auto">
                                        <avalonia:Icon Grid.Column="0" Value="{Binding Icon}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Classes="muted" FontSize="11" Text="{Binding Hint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Classes="faint" FontSize="10.5" Text="{Binding Group}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="7" Classes="kbd" IsVisible="{Binding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding Shortcut}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>
        </Panel>
    </Panel>
</Window>
