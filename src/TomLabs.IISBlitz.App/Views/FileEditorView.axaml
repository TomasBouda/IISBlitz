<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TomLabs.IISBlitz.App.ViewModels"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:behaviours="clr-namespace:TomLabs.IISBlitz.App.Behaviours"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             x:Class="TomLabs.IISBlitz.App.Views.FileEditorView"
             x:DataType="vm:OpenFileViewModel">
    <!-- An extra file tab: path, state chips and an editor with the grammar picked by extension. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="hairline-b fade-in" Padding="18,8">
            <Grid ColumnDefinitions="Auto,8,*,8,Auto,8,Auto,8,Auto,4,Auto">
                <avalonia:Icon Grid.Column="0" Value="fa-solid fa-file-lines" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2" Classes="mono secondary" FontSize="11.5" VerticalAlignment="Center"
                           Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                    <Border Classes="chip accent" IsVisible="{Binding IsDirty}"><TextBlock Text="modified"/></Border>
                    <Border Classes="chip" IsVisible="{Binding IsMissing}"><TextBlock Text="missing"/></Border>
                </StackPanel>
                <TextBlock Grid.Column="6" Classes="mono muted" FontSize="10.5" Text="{Binding Status}" VerticalAlignment="Center"/>
                <Button Grid.Column="8" Classes="icon" Name="ReloadButton" ToolTip.Tip="Reload from disk (discards unsaved changes)">
                    <avalonia:Icon Value="fa-solid fa-arrows-rotate" FontSize="12"/>
                </Button>
                <Button Grid.Column="10" Classes="accent" Padding="8,4" Name="SaveButton" ToolTip.Tip="Save (Ctrl+S saves every open file)">
                    <StackPanel><avalonia:Icon Value="fa-solid fa-floppy-disk" FontSize="11"/><TextBlock Text="Save"/></StackPanel>
                </Button>
            </Grid>
        </Border>
        <avaloniaEdit:TextEditor x:Name="Editor">
            <Interaction.Behaviors>
                <behaviours:DocumentTextBindingBehavior Text="{Binding Content, Mode=TwoWay}"/>
            </Interaction.Behaviors>
        </avaloniaEdit:TextEditor>
    </DockPanel>
</UserControl>
